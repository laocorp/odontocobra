# Reference template for the public Supabase values used by the Vite app.
# The app reads env files from the repository root; use the root .env.example
# for local setup and configure these values in Dokploy before building.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
